# Redis / Celery
# Celery gets its own Redis database and queue name so a Redis instance
# shared with other services never mixes up tasks between services.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USE_SSL=false
REDIS_CELERY_DB=2
CELERY_TASK_DEFAULT_QUEUE=sg_commons_queue

# ── AI search: LLM filter extraction via the AI-Service gateway ──────────────
AI_SERVICE_BASE_URL=http://127.0.0.1:7001
# Bearer token from AI-Service's scripts/dev_setup.py. Required.
AI_SERVICE_TOKEN=''
# Gateway tenant to bill and load provider keys for. Deployment-wide, no bot override.
AI_SERVICE_TENANT_ID=''
# Vendor/model for /v1/chat; provider must exist in PROVIDER_MAP and AI Service must have the corresponding tenant key.
# Deployment-wide, no bot override: every search hits the same gateway target.
AI_SERVICE_PROVIDER=bedrock
AI_SERVICE_MODEL=us.meta.llama3-3-70b-instruct-v1:0

# off = never, fallback = only when the fuzzy matcher is unsure, always = every
# search. Deployment-wide, no bot override: this is the on/off switch for the LLM.
AI_SEARCH_LLM_MODE=fallback
# Fuzzy confidence below which 'fallback' calls the LLM; 0-1. Per bot: llm_confidence_threshold
AI_SEARCH_LLM_CONFIDENCE_THRESHOLD=0.5

# Orgs in the prompt: candidates = fuzzy top-N, full = all active, auto = full
# while the list is small. Per bot: llm_org_vocab_mode
AI_SEARCH_LLM_ORG_VOCAB_MODE=auto
# Max orgs sent in 'candidates' mode. Per bot: llm_org_candidate_limit
AI_SEARCH_LLM_ORG_CANDIDATE_LIMIT=10
# Org count above which 'full' downgrades to 'candidates'. Per bot: llm_org_full_max
AI_SEARCH_LLM_ORG_FULL_MAX=50
# Send only the fuzzy matcher's orgs, unpadded, instead of the whole list. Overrides
# the mode above when it returned candidates, and falls back to the full list when it
# did not. Off by default: with it on, that matcher's recall is the ceiling for
# organization filtering. Per bot: llm_org_use_fuzzy_candidates
AI_SEARCH_LLM_ORG_USE_FUZZY_CANDIDATES=false

# Route of the AI search filter bot, and the only bot route that is configurable.
# The older /sg_search_bot is a separate row that tunes the vector query; the
# seeding script refuses to run if this is pointed at it.
AI_SEARCH_BOT_ROUTE=/ai_search_filters
# Admin-facing label for that row, applied only when create_ai_search_bot.py
# creates it from nothing. An existing row is renamed in the Django admin.
AI_SEARCH_BOT_NAME='SG Commons AI Search Filter Bot'

# Tries per call; only timeouts, 429 and 5xx retry. Per bot: llm_max_attempts
AI_SERVICE_MAX_ATTEMPTS=2
# Backoff base seconds between retries. Per bot: llm_backoff_base_s
AI_SERVICE_BACKOFF_BASE_S=0.4
# Ceiling for the whole call including retries. Per bot: llm_max_elapsed_s
# Keep above AI_SERVICE_MAX_ATTEMPTS x the bot's read_timeout plus the backoff,
# or the deadline expires before the first attempt returns and retries never run.
AI_SERVICE_MAX_ELAPSED_S=35.0
# Consecutive failures before the LLM is skipped. Per bot: llm_cooldown_after_failures
AI_SERVICE_COOLDOWN_AFTER_FAILURES=3
# How long to keep skipping it. Per bot: llm_cooldown_seconds
AI_SERVICE_COOLDOWN_SECONDS=30
# Longer cooldown for config failures (bad token, missing tenant key), starting
# on the first one. Per bot: llm_config_cooldown_seconds
AI_SERVICE_CONFIG_COOLDOWN_SECONDS=300
